name: Deploy Firebase Backend V17

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy-firebase:
    runs-on: ubuntu-latest
    env:
      FIREBASE_PROJECT_ID: ${{ secrets.FIREBASE_PROJECT_ID }}
      GOOGLE_APPLICATION_CREDENTIALS: ${{ github.workspace }}/firebase-service-account.json

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Locate and extract V17 project
        shell: bash
        run: |
          set -euo pipefail
          rm -rf deploy
          mkdir -p deploy

          if [ -f "marathi_brain_challenge_fixed_v17.zip" ]; then
            unzip -q -o "marathi_brain_challenge_fixed_v17.zip" -d deploy/outer
          elif [ -f "v2-project.zip" ]; then
            mkdir -p deploy/outer
            cp v2-project.zip deploy/outer/
          else
            echo "ERROR: Upload marathi_brain_challenge_fixed_v17.zip (or v2-project.zip) to the repository root."
            exit 1
          fi

          if [ -f deploy/outer/v2-project.zip ]; then
            unzip -q -o deploy/outer/v2-project.zip -d deploy/project
          else
            echo "ERROR: v2-project.zip was not found inside the uploaded V17 package."
            exit 1
          fi

          test -f deploy/project/firebase/functions/index.js
          test -f deploy/project/firebase/firestore.rules
          test -f deploy/project/firebase/functions/package.json
          test -f deploy/project/firebase.json

      - name: Validate required GitHub secrets
        shell: bash
        run: |
          set -euo pipefail
          if [ -z "${FIREBASE_PROJECT_ID:-}" ]; then
            echo "ERROR: Missing GitHub Actions secret FIREBASE_PROJECT_ID"
            exit 1
          fi
          if [ -z "${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}" ]; then
            echo "ERROR: Missing GitHub Actions secret FIREBASE_SERVICE_ACCOUNT_JSON"
            exit 1
          fi

      - name: Create service-account file
        shell: bash
        env:
          FIREBASE_SERVICE_ACCOUNT_JSON: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}
        run: |
          set -euo pipefail
          printf '%s' "$FIREBASE_SERVICE_ACCOUNT_JSON" > "$GOOGLE_APPLICATION_CREDENTIALS"
          node -e "const fs=require('fs'); const p=process.env.GOOGLE_APPLICATION_CREDENTIALS; const x=JSON.parse(fs.readFileSync(p,'utf8')); if(!x.client_email || !x.private_key) throw new Error('Invalid service-account JSON'); console.log('Service account JSON format OK');"

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Firebase CLI
        run: npm install --global firebase-tools

      - name: Install Cloud Functions dependencies
        working-directory: deploy/project/firebase/functions
        run: npm ci

      - name: Configure Firebase project
        working-directory: deploy/project
        run: |
          printf '{"projects":{"default":"%s"}}\n' "$FIREBASE_PROJECT_ID" > .firebaserc
          cat .firebaserc

      - name: Deploy Firestore rules and Cloud Functions
        working-directory: deploy/project
        run: |
          firebase deploy --project "$FIREBASE_PROJECT_ID" --only firestore:rules,functions --non-interactive

      - name: Cleanup credentials
        if: always()
        run: rm -f "$GOOGLE_APPLICATION_CREDENTIALS"
